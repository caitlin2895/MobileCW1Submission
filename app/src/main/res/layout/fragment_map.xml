<?xml version="1.0" encoding="utf-8"?>
<!-- Map screen: title + back button along the top, Google map underneath (Lab 7 / MPD_06c_Maps) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/mapTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:text="Search for a road, then press Show results on map"
            />
        <Button
            android:id="@+id/mapBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to search"
            />
    </LinearLayout>

    <!-- the map fragment from Lab 7 (activity_maps.xml) - fills the rest of the screen -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />
</LinearLayout>